# Local Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_COMMIT_SHA=local
WORKER_POLL_SECONDS=60
DELIVERY_RETRY_MINUTES=60
INGESTION_INTERVAL_HOURS=6
YOUTUBE_PAGE_LIMIT=2
PUBLIC_APP_URL=http://localhost:8000

# Admin API trust boundary. Production must also have Vercel Authentication
# enabled with the All Deployments protection scope before deployment.
VERCEL_OIDC_TEAM_SLUG=
VERCEL_OIDC_PROJECT_NAME=finite-feed
VERCEL_OIDC_ENVIRONMENT=development

# Add locally or through provider secret stores. Never commit real values.
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-xs
EMBEDDING_MODEL_REVISION=d8c86521100d3556476a063fc2342036d45c106f
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=
EMBEDDING_OFFLINE=false
TELEGRAM_PRODUCTION_BOT_TOKEN=
TELEGRAM_DEVELOPER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRODUCTION_CHAT_ID=
DEVELOPER_TELEGRAM_USER_IDS=
